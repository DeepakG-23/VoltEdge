{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A mobile accessory product in the VoltEdge catalog.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full display name of the product.",
          "minLength": 2,
          "maxLength": 140
        },
        "shortName": {
          "type": "string",
          "description": "Short display name of the product.",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "description": "Product category classification.",
          "enum": [
            "Phone Cases",
            "Chargers & Cables",
            "Screen Protectors",
            "Earbuds",
            "Power Banks",
            "Smart Watches"
          ],
          "minLength": 3,
          "maxLength": 40
        },
        "price": {
          "type": "number",
          "description": "Current selling price in INR."
        },
        "originalPrice": {
          "type": "number",
          "description": "Original MRP in INR."
        },
        "stock": {
          "type": "number",
          "description": "Available inventory units."
        },
        "rating": {
          "type": "number",
          "description": "Average star rating from 1 to 5."
        },
        "reviewsCount": {
          "type": "number",
          "description": "Total number of verified customer reviews."
        },
        "image": {
          "type": "string",
          "description": "Primary image URL or data URI.",
          "minLength": 1,
          "maxLength": 15000
        },
        "tagline": {
          "type": "string",
          "description": "Short engineering summary tagline.",
          "minLength": 2,
          "maxLength": 240
        },
        "description": {
          "type": "string",
          "description": "Detailed product description.",
          "minLength": 2,
          "maxLength": 1200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "name",
        "shortName",
        "category",
        "price",
        "originalPrice",
        "stock",
        "rating",
        "reviewsCount",
        "image",
        "tagline",
        "description",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order containing shipping and payment metadata.",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "description": "Human-readable order code (e.g., VE-20260930-001).",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the buyer.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the recipient.",
          "minLength": 2,
          "maxLength": 100
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "description": "Email address of the customer.",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "10-digit Indian mobile number.",
          "minLength": 10,
          "maxLength": 15
        },
        "addressSummary": {
          "type": "string",
          "description": "Formatted Indian shipping address.",
          "minLength": 5,
          "maxLength": 400
        },
        "itemsSummary": {
          "type": "string",
          "description": "Summary of ordered hardware items and quantities.",
          "minLength": 2,
          "maxLength": 1000
        },
        "subtotal": {
          "type": "number",
          "description": "Order subtotal in INR."
        },
        "shipping": {
          "type": "number",
          "description": "Shipping fee in INR."
        },
        "discount": {
          "type": "number",
          "description": "Promotional discount in INR."
        },
        "total": {
          "type": "number",
          "description": "Final payable amount in INR."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Card", "COD"],
          "description": "Selected payment method.",
          "minLength": 3,
          "maxLength": 10
        },
        "paymentDetails": {
          "type": "string",
          "description": "Masked payment reference.",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Packed", "Shipped", "Delivered"],
          "description": "Fulfillment lifecycle status.",
          "minLength": 6,
          "maxLength": 16
        },
        "date": {
          "type": "string",
          "description": "Formatted order date string.",
          "minLength": 4,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when order was placed."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when order was last updated."
        }
      },
      "required": [
        "orderCode",
        "userId",
        "customerName",
        "customerEmail",
        "phone",
        "addressSummary",
        "itemsSummary",
        "subtotal",
        "shipping",
        "discount",
        "total",
        "paymentMethod",
        "paymentDetails",
        "status",
        "date",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserWishlist": {
      "title": "UserWishlist",
      "description": "Per-user saved wishlist of product IDs.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productIds": {
          "type": "array",
          "description": "Bounded list of saved product numeric IDs (max 50)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last wishlist update."
        }
      },
      "required": ["userId", "productIds", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile details and saved addresses book isolated by userId.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Display full name of the user.",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Primary email address.",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "10-digit Indian mobile number.",
          "minLength": 10,
          "maxLength": 15
        },
        "smsAlerts": {
          "type": "boolean",
          "description": "Whether SMS order dispatch alerts are enabled."
        },
        "addressesList": {
          "type": "array",
          "description": "Bounded list of formatted saved address strings (max 10)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "userId",
        "fullName",
        "email",
        "phone",
        "smsAlerts",
        "addressesList",
        "updatedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator membership document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email.",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin role was provisioned."
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Storefront hardware catalog items."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders isolated by userId and accessible to verified admins."
    },
    "/wishlists/{userId}": {
      "schema": "UserWishlist",
      "description": "Private user wishlist documents keyed by userId."
    },
    "/user_profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Private customer profile settings and saved addresses book keyed by userId."
    },
    "/admins/{adminId}": {
      "schema": "AdminRole",
      "description": "System-managed administrator role lookup collection."
    }
  }
}
